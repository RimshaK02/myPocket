# Docker Compose Environment Variables
# Find your IP: ifconfig | grep "inet " | grep -v 127.0.0.1

# Your computer's IP address for mobile app connection
EXPO_HOST=YOUR_IP_HERE

# API server URL (should match your IP address)
# EXPO_PUBLIC_ prefix makes it available to the app
EXPO_PUBLIC_API_URL=http://YOUR_IP_HERE:3000
